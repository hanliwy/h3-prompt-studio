{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.minimax.h3.promptmaster",
  "productName": "MiniMax-H3 PromptMaster",
  "copyright": "Copyright © 2026 MiniMax-H3 Studio",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "hanliwy",
    "repo": "h3-prompt-studio"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "data/h3-skills",
      "to": "skills/h3-skills"
    },
    {
      "from": "data/image-skills",
      "to": "skills/image-skills"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MiniMax-H3 PromptMaster"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ]
  }
}
