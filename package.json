{
  "name": "minimax-h3-prompt-master",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder -mwl",
    "clean": "rm -rf dist release server.cjs",
    "lint": "tsc --noEmit",
    "test": "npm run test:h3-skills && npm run test:h3-agent && npm run test:h3-openai-adapter && npm run test:image-skills && npm run test:image-style-randomization && npm run test:generation-controllers && npm run test:image-prompt && npm run test:image-server && npm run test:gallery-scanner && npm run test:history-store && npm run test:electron-packaging && npm run test:server-lifecycle && npm run test:sse && npm run test:layout && npm run test:navbar",
    "test:h3-skills": "tsx tests/h3SkillRuntime.test.ts",
    "test:h3-agent": "tsx tests/h3AgentRuntime.test.ts && tsx tests/h3AgentRuntime.next.test.ts",
    "test:h3-openai-adapter": "tsx tests/h3OpenAiAdapter.test.ts",
    "test:image-skills": "tsx tests/imageSkillRuntime.test.ts",
    "test:image-style-randomization": "tsx tests/imageStyleRandomization.test.ts",
    "test:generation-controllers": "tsx tests/generationControllerIsolation.test.ts",
    "test:image-prompt": "tsx tests/imagePromptRuntime.test.ts",
    "test:image-server": "tsx tests/imagePromptServer.test.ts",
    "test:gallery-scanner": "tsx tests/galleryScanner.test.ts",
    "test:history-store": "tsx tests/historyStore.test.ts",
    "test:electron-packaging": "tsx tests/electronPackaging.test.ts",
    "test:server-lifecycle": "tsx tests/serverLifecycle.test.ts",
    "test:sse": "tsx tests/sse.test.ts",
    "test:layout": "tsx tests/promptGeneratorLayout.test.ts",
    "test:navbar": "tsx tests/navbarBranding.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
